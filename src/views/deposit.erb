<!DOCTYPE html>
<html>
<head>
  <title>Depósito</title>
  <link rel="stylesheet" href="/css/theme/dark.css">
  <link rel="stylesheet" href="/css/transfer.css">
</head>
<body>
  <header>
    <h2>Depositar Dinero</h2>
  </header>
  <section>
    <% if params[:error] %>
      <div class="error-msg"><%= params[:error] %></div>
    <% elsif params[:success] %>
      <div class="success-msg">Depósito exitoso.</div>
    <% end %>

    <div class="saldo-box">
      <label>Saldo actual</label>
      <div class="saldo-monto">$<%= @account.saldo %></div>
    </div>

    <form action="/api/deposit" method="post">
      <input type="number" name="amount" placeholder="Monto" step="0.01" required><br>
      <label>Monto</label><br>
      <button type="submit" class="submit">Confirmar</button>
    </form>
  </section>
  <footer>
    ByTheMostCapos
  </footer>
</body>
</html>
