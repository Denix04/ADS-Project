<!DOCTYPE html>
<html>
<head>
  <title>My Sinatra App</title>
  <link rel="stylesheet" href="/css/theme/dark.css">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>

  <header>
    <h2>Log In</h2>
  </header>

  <section>
    <% if params[:error] %>
      <div class="error-msg"><%= params[:error] %></div>
    <% elsif params[:success] %>
      <div class="success-msg">Logeado exitosamente.</div>
    <% end %>

    <form action='/api/login' method="post">

      <input type="email" name="email" placeholder="example@gmail.com" required><br>
      <label>Email</label><br>

      <input type="password" name="password_digest" placeholder="********" required><br>
      <label>Password</label><br>

      <button type="submit" id="confirm" class="submit">Confirmar</button>
    </form>
   
    <div class="recuperar">
        <button id="cancel" class="boton"> ¿Olvidaste tu contraseña? </button>
    </div>

    <div class="registro">
        <button id="register_btn" class="boton"> Registrarse </button>
    </div>
  </section>

  <footer>
    ByTheMostCapos
  </footer>

  <script src="/js/login.js"></script>
</body>
</html>
