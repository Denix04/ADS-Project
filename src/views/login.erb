<!DOCTYPE html>
<html>
<head>
  <title>My Sinatra App</title>
  <link rel="stylesheet" href="/css/theme/dark.css">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>

  <header>
    <h2>Log In</h2>
  </header>

  <section>

    <form action='/' method="post">

      <input type="text" name="text" placeholder="NombreDeUsuario" required><br>
      <label>Username</label><br>

      <input type="password" name="password" placeholder="********" required><br>
      <label>Password</label><br>

      <button type="submit" id="confirm" class="submit">Confirmar</button>
    </form>
   
    <div class="recuperar">
        <button id="cancel" class="boton"> ¿Olvidaste tu contraseña? </button>
    </div>

    <div class="registro">
        <button id="cancel" class="boton"> Registrarse </button>
    </div>
  </section>

  <footer>
    ByTheMostCapos
  </footer>

  <script src="/js/script.js"></script>
</body>
</html>
