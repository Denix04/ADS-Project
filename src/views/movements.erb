<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Movements</title>
  <link rel="stylesheet" href="/css/movements.css">
  
</head>
<body>
  <div class="container">
    <div class="top-bar">
      <span class="back"><a href="/main">Back</a></span>
    </div>

    <h1 class="title">Movements</h1>
    <hr>

    <div class="movements">
      <% if @movements.empty? %>
        <div class="movement ">
          <p>No se registraron movimientos aún.</p>
        </div>
      <% else %>
        <% @movements.each do |mov| %>
          <% if mov.origin_id == @account.id %>
            <% signo = "-" %>
            <% clase = "egreso" %>
            <% persona = mov.destination&.user&.name || mov.service || "Sin descripción" %>
          <% else %>
            <% signo = "+" %>
            <% clase = "ingreso" %>
            <% persona = mov.origin&.user&.name || "Desconocido" %>
          <% end %>
          <div class="movement <%= clase %>">
            <span class="left"><%= persona %></span>
            <span class="center"><%= signo %> $<%= '%.2f' % mov.amount %></span>
            <span class="right"><%= mov.reason || mov.service || mov.type %></span>
          </div>
        <% end %>
      <% end %>
    </div>

    <footer>
      <div class="footer-content">
        <span> </span>
        <span> </span>
        <span> </span>
      </div>
    </footer>
  </div>
</body>
</html>