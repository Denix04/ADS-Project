<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Cuenta secundaria</title>
  <link rel="stylesheet" href="/css/perfilsecundario.css">
</head>
<body>
  <div class="container">
    <div class="header">
      <a href="#" class="back">Back</a>
      <h2 class="title">Abril Debernardi <span class="icon">🛈</span></h2>
      <hr>
    </div>

    <div class="balance-card">
      <span class="amount">$ 1.000</span>
      <span class="icon">🛈</span>
    </div>

    <div class="table">
      <div class="row">
        <div class="cell">Aldito Sanchez</div>
        <div class="cell">$ 4.653,28</div>
        <div class="cell">Buena Conducción</div>
      </div>
      <div class="row">
        <div class="cell">Prox. Monto</div>
        <div class="cell">$ 130.000,00</div>
        <div class="cell">Banco Internacional</div>
      </div>
      <div class="row">
        <div class="cell">Mama</div>
        <div class="cell">$13.000,00</div>
        <div class="cell">Deuda</div>
      </div>
      <div class="row">
        <div class="cell">Prox.</div>
        <div class="cell">$6.559,06</div>
        <div class="cell">No Comentarios</div>
      </div>
    </div>

    <div class="restricciones">
      <h3 class="restricciones-title">Restricciones Activas <span class="icon">🛈</span></h3>
      <hr>
      <div class="restriccion-row">
        <span>Restricción de Monto</span>
        <span>15/04 - 14/06</span>
        <span>Monto: $1000</span>
      </div>
      <div class="restriccion-row">
        <span>Restricción de Monto</span>
        <span>15/04 - 14/06</span>
        <span>Monto: $1000</span>
      </div>
      <div class="restriccion-row">
        <span>Restricción por Horario</span>
        <span>15/04 - 14/06</span>
        <span>Monto: $500</span>
      </div>
      <div class="buttons">
        <button class="btn">Desactivar Cuenta Secundaria</button>
        <button class="btn">Añadir Restricción</button>
      </div>
    </div>
  </div>
</body>
</html>
