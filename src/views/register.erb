<!DOCTYPE html>
<html>
<head>
  <title>Wallet | Registrarse</title>
  <link rel="icon" href="/img/billete.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/theme/dark.css">
  <link rel="stylesheet" href="/css/login.css">
  <link rel="stylesheet" href="/css/register.css">
</head>
<body>

  <header>
    <h2>Registration</h2>
  </header>

  <section>

    <form action='/api/register' method="post">

        <div class="campos">

            <div class="campo">
                <input type="text" name="name" placeholder="Nombre" required><br>
                <label>Nombre</label>
            </div>  
            <div class="campo">
                <input type="text" name="last_name" placeholder="Apellido" required><br>
                <label>Apellido</label>
            </div>
            <div class="campo">
                <input type="text" name="dni" placeholder="12345678" required><br>
                <label>DNI</label>
            </div>
            <div class="campo">
                <input type="text" name="locality" placeholder="Rio Cuarto" required><br>
                <label>Localidad</label>
            </div>
            <div class="campo">
                <input type="email" name="email" placeholder="example@gmail.com" required><br>
                <label>Email</label>
            </div>
            <div class="campo">
                <input type="password" name="password_digest" placeholder="********" required><br>
                <label>Password</label>
            </div>

        </div>
     
      
        <div class="botones-registro">
            <button type="button" id="cancela" class="submit">Cancelar</button>
            <button type="submit" id="confirm" class="submit">Confirmar</button>
        </div> 
    </form>
    
  </section>

  <footer>
    © 2025 Wallet
  </footer>

  <script src="/js/register.js"></script>
</body>
</html>
