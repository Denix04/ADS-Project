<!DOCTYPE html>
<html>
<head>
  <title>My Sinatra App</title>
  <link rel="stylesheet" href="/css/theme/dark.css">
  <link rel="stylesheet" href="/css/login.css">
	<link rel="stylesheet" href="/css/servicio.css">
</head>
<body>

  <header>
    <h2>Pagar Servicio</h2>
  </header>


	<section>

	<form action='api/servicepayment' method="post">

		<input type="text" name="nombre-servicio" class="buscador" placeholder="|Buscar servicio">

		<h3>Servicios frecuentes</h3>
		<div class="servicios-opciones">

			<div class="serv">
				<img src="/img/agua.png" alt="Agua" width="50">
				<hr>
				<p>Agua</p>
			</div>
			<div class="serv">
				<img src="/img/luz.png" alt="Luz" width="50">
				<hr>
				<p>Luz</p>
			</div>
			<div class="serv">
				<img src="/img/gas.png" alt="Gas" width="50">
				<hr>
				<p>Gas</p>
			</div>
		</div>

		<input type="number" name="amount" step="0.01" min="0" placeholder="0.00" required><br>
    <label>Monto a pagar</label><br>

	 
		<div class="botones-registro">
			<button type="button" href="/main" id="cancela" class="submit">Cancelar</button>
			<button type="submit" id="confirm" class="submit">Confirmar</button>
		</div> 
	</form>

	<% if params[:error] %>
      <div class="error-msg"><%= params[:error] %></div>
    <% elsif params[:success] %>
      <div class="success-msg">Pago realizado exitosamente.</div>
    <% end %>
	
</section>

<footer>
  © 2025 Wallet
</footer>

<script src="/js/servicio.js"></script>
</body>
</html>
