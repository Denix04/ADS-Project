<!DOCTYPE html>
<html>
<head>
  <title>Wallet | Transferencia</title>
  <link rel="icon" href="/img/billete.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/theme/dark.css">
  <link rel="stylesheet" href="/css/transfer.css">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <header>
    <h2>Transferencia</h2>
  </header>

  <section>
    <% if params[:error] %>
      <div class="error-msg"><%= params[:error] %></div>
    <% elsif params[:success] %>
      <div class="success-msg">Transferencia realizada exitosamente.</div>
    <% end %>

    <div class="saldo-box">
      <label>Saldo actual</label>
      <div class="saldo-monto">$<%= User.find(session[:id]).account.saldo %></div>
    </div>

    <form action="/api/transfer" method="post">
      <input type="text" name="cbu" placeholder="CBU o Alias" required><br>
      <label>CBU/Alias</label><br>

      <input type="number" name="amount" placeholder="Monto" required step="0.01" min="0.01"><br>
      <label>Monto</label><br>

      <button type="submit" class="submit">Confirmar</button>
      <a href="/main"><button type="button" class="boton">Cancelar</button></a>
    </form>
  </section>

  <footer>
    © 2025 Wallet
  </footer>

  <script src="/js/transfer.js"></script>
</body>
</html>
